{
    "permissions": {
      "deny": [
        "Read(./secrets/**)",
        "Read(./**/*.key)",
        "Read(./**/*.pem)",
        "Read(./.env)",
        "Bash(curl:*)",
        "Bash(wget:*)",
        "Bash(rm -rf:*)",
        "Bash(git push:*)"
      ],
      "allow": [
        "Read(./data/**)",
        "Read(./analysis/**)",
        "Edit(./analysis/**)",
        "Bash(uv run:*)"
      ]
    }
  }